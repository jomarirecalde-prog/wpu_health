APP_NAME="WPU HealthHub"
HEALTHHUB_NAME="WPU HealthHub"
HEALTHHUB_TAGLINE="Your unified gateway to campus wellness."
HEALTHHUB_AUTHORIZED_EMAILS=hso@wpu.edu.ph
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/wpu_medical-master

# Production recommendations (uncomment for deployment):
# APP_ENV=production
# APP_DEBUG=false
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis
# DB_PERSISTENT=true
# LOG_LEVEL=warning

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=health_records
DB_USERNAME=root
DB_PASSWORD=

# Persistent PDO connections for legacy portal (use with caution under PHP-FPM)
# DB_PERSISTENT=false

# WPU HIS performance tuning
# WPU_REFERENCE_CACHE_TTL=900
# WPU_SETTINGS_CACHE_TTL=120
# WPU_DASHBOARD_CACHE_TTL=60
# WPU_REPORTS_QUEUE=default
# WPU_ACTIVITY_LOGS_QUEUE=default

# APP_TIMEZONE=Asia/Manila

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Production security hardening:
# APP_ENV=production
# APP_DEBUG=false
# SESSION_DRIVER=database
# SESSION_ENCRYPT=true
# SESSION_SECURE_COOKIE=true
# SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
